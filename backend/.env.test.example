# Copy to .env.test or export before running integration tests locally.
# Do NOT point at production/dev Neon.

TEST_DATABASE_URL="postgresql://test:test@localhost:5432/pms_test?schema=public"
DATABASE_URL="postgresql://test:test@localhost:5432/pms_test?schema=public"
DIRECT_URL="postgresql://test:test@localhost:5432/pms_test?schema=public"

# Start Postgres (example):
# docker run -d --name pms-test-db -p 5432:5432 \
#   -e POSTGRES_USER=test -e POSTGRES_PASSWORD=test -e POSTGRES_DB=pms_test \
#   postgres:16
#
# cd backend && npx prisma migrate deploy && npm run test:integration
