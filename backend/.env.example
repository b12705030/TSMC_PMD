# App
PORT=4000
NODE_ENV=development

# PostgreSQL — 從 Neon dashboard 取得（https://console.neon.tech）
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Read Replica — 從 Neon dashboard > Branches > Add Compute > Read Replica 取得
REPLICA_DATABASE_URL="postgresql://user:password@ep-xxxx-replica.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Session — 隨機字串，建議 openssl rand -hex 32 產生
SESSION_SECRET=change_this_to_a_random_secret_string

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000
